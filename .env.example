# Copie para .env (não versionar). Senhas abaixo são só de desenvolvimento.

# Superusuário: usado apenas por db/bootstrap.sh e pelos testes
PGSUPER_URL=postgresql://postgres:pg_dev_pw@127.0.0.1:5432/postgres
PGSUPER_DB_URL=postgresql://postgres:pg_dev_pw@127.0.0.1:5432/helpdesk

# Passwords das roles criadas pelo bootstrap
OWNER_PASSWORD=owner_dev_pw
APP_PASSWORD=app_dev_pw
WORKER_PASSWORD=worker_dev_pw

# Dono do schema: SÓ migrations
DATABASE_URL_OWNER=postgresql://sd_owner:owner_dev_pw@127.0.0.1:5432/helpdesk

# Usados pela aplicação
DATABASE_URL=postgresql://sd_app:app_dev_pw@127.0.0.1:5432/helpdesk            # API (sujeita a RLS)
DATABASE_URL_WORKER=postgresql://sd_worker:worker_dev_pw@127.0.0.1:5432/helpdesk  # jobs / webhooks (BYPASSRLS)

# ---------- API (api/) ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Gere com: openssl rand -base64 48   (mín. 32 caracteres)
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Em produção sempre true (exige HTTPS). Navegadores aceitam Secure em http://localhost.
COOKIE_SECURE=true
CORS_ORIGIN=http://localhost:5173
BCRYPT_COST=12

# ---------- Worker (api/src/worker) ----------
# Links nos e-mails apontam para o front
APP_URL=http://localhost:5173
# Mailpit (docker compose): SMTP em 1025, caixa de entrada em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Helpdesk <no-reply@helpdesk.local>"
WORKER_SLA_INTERVAL_MS=60000
WORKER_EMAIL_INTERVAL_MS=5000
WORKER_AUTOMATION_INTERVAL_MS=5000
EMAIL_MAX_ATTEMPTS=5

# ---------- Anexos (S3-compatível; em dev, SeaweedFS do docker compose) ----------
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=helpdesk-attachments
S3_ACCESS_KEY=helpdesk_dev_key
S3_SECRET_KEY=helpdesk_dev_secret_change_me
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# ---------- Cobrança ----------
# fake = checkout simulado (dev). asaas = Asaas real (sandbox: https://api-sandbox.asaas.com/v3)
BILLING_PROVIDER=fake
BILLING_FAKE_SECRET=dev-only-fake-billing-secret-change-me
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# Token configurado no painel do Asaas para o webhook (cabeçalho asaas-access-token)
# ASAAS_WEBHOOK_TOKEN=
