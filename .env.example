# Copie para .env (não versionar). Senhas abaixo são só de desenvolvimento.

# Superusuário: usado apenas por db/bootstrap.sh e pelos testes
PGSUPER_URL=postgresql://postgres:pg_dev_pw@127.0.0.1:5432/postgres
PGSUPER_DB_URL=postgresql://postgres:pg_dev_pw@127.0.0.1:5432/helpdesk

# Passwords das roles criadas pelo bootstrap
OWNER_PASSWORD=owner_dev_pw
APP_PASSWORD=app_dev_pw
WORKER_PASSWORD=worker_dev_pw

# Dono do schema: SÓ migrations
DATABASE_URL_OWNER=postgresql://sd_owner:owner_dev_pw@127.0.0.1:5432/helpdesk

# Usados pela aplicação
DATABASE_URL=postgresql://sd_app:app_dev_pw@127.0.0.1:5432/helpdesk            # API (sujeita a RLS)
DATABASE_URL_WORKER=postgresql://sd_worker:worker_dev_pw@127.0.0.1:5432/helpdesk  # jobs / webhooks (BYPASSRLS)
